# Template only — names, never values. Copy to .env.local and fill in.
# .env.local is gitignored; production values live in Vercel env vars.

# --- Database ---
MONGODB_URI=

# --- Auth (NextAuth v5) ---
# Leave AUTH_URL / NEXTAUTH_URL UNSET everywhere. auth.ts sets trustHost, so the
# callback origin follows the request host and every alias signs in against
# itself. Pinning one host breaks all the others: the state cookie is written on
# the host you browsed, Google returns you to the pinned host, the check finds no
# cookie and NextAuth answers /api/auth/error?error=Configuration.
# Each host you sign in from needs its own entry in the Google OAuth client's
# authorized redirect URIs: https://<host>/api/auth/callback/google
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Production only, and a workaround rather than the destination. Google's OAuth
# client lists a redirect URI for my-pet-self.vercel.app but not for
# www.mypetge.online, and only the Google account owner can add one. With this
# set, www hands Google the vercel.app redirect URI and hides its own callback
# inside the encrypted state; vercel.app decodes it with the shared AUTH_SECRET
# and 302s back, so the token exchange finishes on www where the state cookie
# lives. Cost is one visible hop through vercel.app mid-login.
# Delete it the day the www redirect URI is added in Google Cloud Console:
#   vercel env rm AUTH_REDIRECT_PROXY_URL production --scope salomesajaia97-a11y-d704ebf2
# production value: https://my-pet-self.vercel.app/api/auth
AUTH_REDIRECT_PROXY_URL=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOTSTRAP_SECRET=

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenRouter (AI search/match) ---
OPENROUTER_API_KEY=

# --- Flitt payments (https://docs.flitt.com) ---
# Leave MERCHANT_ID and PAYMENT_KEY unset locally and on preview: the app then
# uses Flitt's public sandbox merchant (1549901 / "test") with the documented
# test cards, and no real money moves. Production requires real values —
# getFlittConfig() throws there rather than charging the wrong account.
FLITT_MERCHANT_ID=
FLITT_PAYMENT_KEY=
FLITT_CREDIT_KEY=
FLITT_API_BASE=https://pay.flitt.com

# Production only, and the `www` matters: the apex 308s to www and Flitt does
# not follow redirects, so an apex callback URL drops every notification.
# Without this the callback origin falls back to the vercel.app alias.
# Must stay UNSET locally — lib/siteUrl.ts warns that a localhost value
# would leak into canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=
# production value: https://www.mypetge.online
