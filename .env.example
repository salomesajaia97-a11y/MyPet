# Template only — names, never values. Copy to .env.local and fill in.
# .env.local is gitignored; production values live in Vercel env vars.

# --- Database ---
MONGODB_URI=

# --- Auth (NextAuth v5) ---
AUTH_SECRET=
AUTH_URL=
AUTH_TRUST_HOST=true
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
BOOTSTRAP_SECRET=

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- OpenRouter (AI search/match) ---
OPENROUTER_API_KEY=

# --- Flitt payments (https://docs.flitt.com) ---
# Leave MERCHANT_ID and PAYMENT_KEY unset locally and on preview: the app then
# uses Flitt's public sandbox merchant (1549901 / "test") with the documented
# test cards, and no real money moves. Production requires real values —
# getFlittConfig() throws there rather than charging the wrong account.
FLITT_MERCHANT_ID=
FLITT_PAYMENT_KEY=
FLITT_CREDIT_KEY=
FLITT_API_BASE=https://pay.flitt.com

# Production only. Without it the callback origin falls back to the vercel.app
# alias. Must stay UNSET locally — lib/siteUrl.ts warns that a localhost value
# would leak into canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=
